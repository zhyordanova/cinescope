{
  "expo": {
    "name": "cinescope",
    "slug": "cinescope",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cinescope-app-icon.png",
    "scheme": "cinescope",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/cinescope-adaptive-foreground.png",
        "monochromeImage": "./assets/cinescope-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/cinescope-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F19",
          "image": "./assets/cinescope-symbol.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
